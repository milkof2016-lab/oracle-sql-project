CREATE OR REPLACE VIEW DEO1.VW_RTGS_DASHBOARD_SUMMARY AS
SELECT 
    t.transfer_id,
    t.transaction_ref,
    c.customer_id,
    c.customer_name,
    a.account_number,
    t.amount,
    t.currency,
    t.status,
    t.transfer_date
FROM 
   DEO1.rtgs_transfers t
JOIN 
    DEO1.accounts a ON t.account_id = a.account_id
JOIN 
  DEO1.customers c ON a.customer_id = c.customer_id;
